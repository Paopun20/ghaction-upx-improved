{
  "name": "upx-github-action",
  "description": "GitHub Action for UPX, the Ultimate Packer for eXecutables",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --sourcemap --minify && yarn run license",
    "lint": "eslint --max-warnings=0 .",
    "format": "eslint --fix .",
    "test": "vitest run",
    "license": "generate-license-file --input package.json --output dist/licenses.txt --overwrite --ci --no-spinner --eol lf",
    "all": "yarn run build && yarn test",
    "dev": "node src/test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazy-max/ghaction-upx.git"
  },
  "keywords": [
    "actions",
    "upx"
  ],
  "author": "CrazyMax",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/core": "^7.0.7",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "generate-license-file": "^4.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
